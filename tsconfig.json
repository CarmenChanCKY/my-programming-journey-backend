{
  "compilerOptions": {
    "target": "ES2018",
    "module": "esnext",
    "outDir": "dist",
    "removeComments": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "config/*": ["config/*"]
    }
  },
  "include": ["./src/**/*", "./config/**/*"],
  "exclude": ["node_modules", "dist", "public"]
}
