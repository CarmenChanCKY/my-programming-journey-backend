# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .

# Build main app (webpack bundles src/index.ts → dist/index.js)
ENV NODE_OPTIONS="--max-old-space-size=2048"
RUN npm run build

# Build create-admin script (scripts/create-admin.ts → dist/create-admin.js)
RUN npx webpack --config docker/backend/webpack.create-admin.js

# Stage 2: Production dependencies only
FROM node:22-alpine AS prod-deps

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Stage 3: Runner
FROM node:22-alpine AS runner

WORKDIR /app

RUN apk add --no-cache mysql-client mariadb-connector-c-dev

# Production-only node_modules (no webpack, ts-loader, etc.)
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/config ./config
COPY --from=builder /app/models ./models
COPY --from=builder /app/migrations ./migrations
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/docker/db/init_db_aws.sql ./init_db_aws.sql
COPY --from=builder /app/docker/backend/create-admin.sh ./create-admin.sh

RUN chmod +x ./create-admin.sh

EXPOSE 3100

CMD ["./create-admin.sh"]
