{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "read": {
      "*.env.example": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "grep": {
      "*.env": "deny"
    },
    "glob": {
      "*.env": "deny"
    },
    "bash": {
      "cat *.env*": "deny",
      "cat .*env*": "deny",
      "printenv*": "deny",
      "env": "deny",
      "grep * .env*": "deny"
    }
  }
}
